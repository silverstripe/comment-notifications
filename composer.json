{
    "name": "silverstripe/comment-notifications",
    "description": "Provides email notifications for visitor comments",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.2",
        "silverstripe/framework": "^6",
        "silverstripe/comments": "^5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "SilverStripe\\CommentNotifications\\": "src/",
            "SilverStripe\\CommentNotifications\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
